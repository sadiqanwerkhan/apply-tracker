generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Email {
  id            String
  userId        String
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  companyKey    String
  company       String
  role          String
  sender        String
  isAts         Boolean
  status        String
  stage         String   @default("update")
  summary       String?
  subject       String
  date          DateTime
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
  @@index([userId])
  @@index([companyKey])
  @@index([applicationId])
}

// ---- Auth.js (NextAuth) tables ----
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  emails        Email[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SkippedEmail {
  userId    String
  messageId String
  createdAt DateTime @default(now())

  @@id([userId, messageId])
  @@index([userId])
}

model ManualOutcome {
  id         String   @id @default(cuid())
  userId     String
  companyKey String
  roleKey    String
  company    String
  role       String
  status     String
  channel    String
  reason     String?
  date       DateTime
  createdAt  DateTime @default(now())

  @@unique([userId, companyKey, roleKey])
  @@index([userId])
}

model AppMerge {
  id         String   @id @default(cuid())
  userId     String
  groupId    String
  companyKey String
  roleKey    String
  company    String
  role       String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([userId, companyKey, roleKey])
  @@index([userId, groupId])
}

model Application {
  id            String    @id @default(cuid())
  userId        String
  companyKey    String
  roleKey       String
  company       String
  role          String

  // manual outcome recorded off-channel (will replace the ManualOutcome table)
  manualStatus  String?
  manualChannel String?
  manualReason  String?
  manualDate    DateTime?

  // merge: if set, this application is folded into another one
  mergedIntoId  String?
  mergedInto    Application?  @relation("AppMergeRel", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom    Application[] @relation("AppMergeRel")

  analysis      String?
  analysisAt    DateTime?
  insights      Json?        // ← ADD: structured interview facts (stack, team, product, pay, next steps)
  insightsAt    DateTime?
  createdAt     DateTime  @default(now())


  emails        Email[]
  stages        Stage[]

  @@index([userId])
  @@index([userId, companyKey])
}

model Stage {
  id            String       @id @default(cuid())
  applicationId String
  name          String
  order         Int          @default(0)
  result        String?
  createdAt     DateTime     @default(now())
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  transcripts   Transcript[]

  @@index([applicationId])
}

model Transcript {
  id        String   @id @default(cuid())
  stageId   String
  label     String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stage     Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([stageId])
}

model ScanJob {
  id        String    @id @default(cuid())
  userId    String
  startDate String
  endDate   String
  status    String    @default("queued") // queued | running | complete | failed
  processed Int       @default(0)
  remaining Int       @default(0)
  truncated Boolean   @default(false)
  error     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, createdAt])
}